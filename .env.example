APP_NAME="Security Cam"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Default: SQLite file database/database.sqlite (no database server needed).
# To use MySQL instead: set DB_CONNECTION=mysql, uncomment the lines below and
# create the database first.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=iot-security-cam
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ESP32-CAM MJPEG stream, printed on the ESP32 Serial Monitor ("Stream Link: ...")
CAMERA_STREAM_URL=http://192.168.38.184/mjpeg/1
# Still image used for motion snapshots (empty = stream URL with /mjpeg/1 replaced by /jpg)
CAMERA_SNAPSHOT_URL=
# Camera preselected on the dashboard: esp32 | laptop (no ESP32-CAM = laptop)
CAMERA_DEFAULT_SOURCE=esp32

# MQTT broker WebSocket listener as seen from the browser (npm run broker -> ws://localhost:8083/mqtt)
MQTT_WS_HOST=localhost
MQTT_WS_PORT=8083
MQTT_WS_PATH=/mqtt
MQTT_WS_TLS=false
MQTT_WS_USERNAME=
MQTT_WS_PASSWORD=
MQTT_TOPIC_PREFIX=seccam

# Bundled broker (scripts/mqtt-broker.mjs): TCP port for the ESP32, WebSocket port for the browser
MQTT_BROKER_TCP_PORT=1883
MQTT_BROKER_WS_PORT=8083
# Optional login for the bundled broker; then also set MQTT_WS_USERNAME/PASSWORD and MQTT_USER/PASS in the ESP32 sketch
MQTT_BROKER_USERNAME=
MQTT_BROKER_PASSWORD=

# Broker address used by `php artisan mqtt:listen` (stores ESP32 events in the database)
MQTT_LISTENER_HOST=127.0.0.1

# Days to keep device events and motion snapshots
EVENTS_RETENTION_DAYS=30

# Dashboard account created by `php artisan db:seed` (empty password = random, printed once)
SEED_USER_EMAIL=admin@seccam.test
SEED_USER_PASSWORD=
